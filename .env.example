# ==========================================
# KSTM AI Monorepo Environment Variables
# ==========================================

# Database & Infrastructure Credentials
POSTGRES_USER=kstm
POSTGRES_PASSWORD=password
POSTGRES_DB=kstm_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://kstm:password@localhost:5433/kstm_db?schema=public"

# Redis (BullMQ, Rate Limiting, Chat Memory)
REDIS_URL="redis://localhost:6379"

# Neo4j Vector Store (Cypher vector index: ecom_index)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Google Gemini API Key
GOOGLE_API_KEY="your-google-api-key"
GEMINI_API_KEY="your-google-api-key"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"

# Stripe Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontend & API Endpoints
NEXT_PUBLIC_API_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8080"
