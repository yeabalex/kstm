# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://kstm:password@localhost:5432/kstm_db?schema=public"

# Application Port
PORT=3000

# JSON Web Token Secret
JWT_SECRET="your-super-secret-jwt-key"

# Redis Connection (BullMQ Queue, Rate Limiting, Chat Memory Cache)
REDIS_URL="redis://localhost:6379"

# Neo4j Vector Store Connection (Native RAG)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password123"

# Google Gemini API Key (Embeddings & Generation)
GOOGLE_API_KEY="your-google-api-key"
GEMINI_API_KEY="your-google-api-key"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
